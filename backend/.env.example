# Bu dosyayı .env olarak kopyalayıp doldurun. .env asla git'e girmez.

# Uygulama ve ElevenLabs'in bu backend'e gösterdiği parola. Uzun ve rastgele seçin:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JARVIS_KEY=

# ElevenLabs (yalnızca özel ajan / imzalı bağlantı için)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Uygulamanın yayınlandığı adres (CORS). Birden çoksa virgülle ayırın. Geliştirirken * bırakılabilir.
APP_ORIGIN=*

# Google Sheets kimlikleri (URL'deki /d/ ile /edit arasındaki uzun parça)
SHEET_DURUM_DEFTERI_ID=
SHEET_TT_ROBOTICS_ID=

# Bulutta token.json yerine (google_auth.py sonunda yazdırır)
# GOOGLE_TOKEN_JSON=

TIMEZONE=Europe/Istanbul
